<?xml version="1.0" encoding="UTF-8"?>
<!--
  WinSW configuration for UAM Activity Agent.
  The Windows service "UAM Activity Agent" is launched by uam-agent-service.exe
  (a renamed copy of WinSW). WinSW reads this file and runs the configured
  command as a child process, proxying service control events.
-->
<service>
  <id>UAMActivityAgent</id>
  <name>UAM Activity Agent</name>
  <description>User Activity Monitoring Agent. Collects login/lock/app usage and reports to the UAM server.</description>

  <executable>%ProgramFiles%\nodejs\node.exe</executable>
  <arguments>"%ProgramFiles%\UAMAgent\src\index.js"</arguments>
  <workingdirectory>%ProgramFiles%\UAMAgent</workingdirectory>

  <log mode="roll-by-size">
    <sizeThreshold>5120</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
  <logpath>%ProgramData%\UAMAgent</logpath>

  <onfailure action="restart" delay="60 sec" />
  <onfailure action="restart" delay="60 sec" />
  <onfailure action="restart" delay="60 sec" />
  <resetfailure>1 hour</resetfailure>

  <startmode>Automatic</startmode>
  <serviceaccount>
    <username>LocalSystem</username>
    <allowservicelogon>true</allowservicelogon>
  </serviceaccount>
</service>
