<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for hosting this Node.js app via iisnode on Windows Server 2022.
  Prerequisites on the server:
    1. IIS with the URL Rewrite module installed.
    2. iisnode installed (https://github.com/Azure/iisnode).
    3. Node.js installed (matching version) - iisnode uses node.exe on PATH.
  Place this file alongside src/server.js (entry point).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="src/server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Send everything to the Node entry point -->
        <rule name="API">
          <match url="/*" />
          <action type="Rewrite" url="src/server.js" />
        </rule>
      </rules>
    </rewrite>

    <iisnode
        nodeProcessCommandLine="&quot;%programfiles%\nodejs\node.exe&quot;"
        watchedFiles="web.config;*.js;src\**\*.js"
        loggingEnabled="true"
        logDirectory="iisnode-logs"
        debuggingEnabled="false"
        devErrorsEnabled="false" />

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
