{
  "name": "uam-client-agent",
  "version": "1.0.0",
  "description": "User Activity Monitoring - Windows Client Agent",
  "main": "src/index.js",
  "bin": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "install-service": "node service/install-service.js",
    "uninstall-service": "node service/uninstall-service.js",
    "build:exe": "pkg . --targets node20-win-x64 --output dist/uam-agent.exe",
    "build:prod": "build-prod.bat",
    "clean": "rmdir /s /q dist node_modules release & del /q package-lock.json",
    "build:sea": "build-sea.bat"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "uuid": "^9.0.1"
  },
  "optionalDependencies": {
    "node-windows": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.16.1"
  },
  "pkg": {
    "scripts": [
      "src/**/*.js"
    ],
    "assets": [
      "src/ps/*.ps1"
    ]
  }
}